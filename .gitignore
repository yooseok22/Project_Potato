# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Last synced: 2025-12-18
# License: CC0-1.0
#
# Place this file in the Unity project root:
# Assets/
# Packages/
# ProjectSettings/
# .gitignore

# Unity-generated directories
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Log files
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Unity Memory Profiler captures
/[Mm]emoryCaptures/

# Unity Recorder output
/[Rr]ecordings/

# Uncomment if Asset Store Tools should not be committed
# /[Aa]ssets/AssetStoreTools*

# JetBrains Rider generated plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# JetBrains Rider personal settings
*.DotSettings.user

# JetBrains IDE project settings
.idea/

# Visual Studio cache
.vs/

# Visual Studio Code personal settings
# Remove this line if the team shares .vscode settings.
.vscode/

# Gradle cache
.gradle/

# Auto-generated IDE and solution files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated metadata for IDE files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash report files
sysinfo.txt
mono_crash.*

# Build files
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Android signing files
*.keystore
*.jks

# Local environment and secret files
.env
.env.*
!.env.example

# Crashlytics-generated file
crashlytics-build.properties

# Test Runner generated files
InitTestScene*.unity*

# Addressables generated build data
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*

# Addressables content state files
# If you use Addressables content update builds,
# consider tracking or separately preserving these files.
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes created by Play Mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# macOS-generated files
.DS_Store
.AppleDouble
.LSOverride

# Windows-generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Temporary backup files
*~
*.bak

.codex/
